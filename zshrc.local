# Only run in interactive shells
[[ $- != *i* ]] && return

# Place local config here, for all interactive shells
alias vim="nvim"
export MANPAGER='nvim +Man!'

setopt EXTENDED_HISTORY       # write timestamps
setopt HIST_IGNORE_ALL_DUPS   # remove older duplicates
setopt SHARE_HISTORY          # across open shells
setopt HIST_REDUCE_BLANKS     # rm deundant whitespace before storing

# Do not start tmux inside tmux
[[ -n "$TMUX" ]] && return

# Do not start tmux on remote machines
[[ -n "$SSH_TTY" ]] && return

# Start or attach to a persistent session
if command -v tmux >/dev/null 2>&1; then
  exec tmux new-session -A -s main
fi

